{
  "name": "neon-herdr",
  "version": "0.1.0",
  "private": true,
  "description": "Manage Neon projects and branches from a Herdr dashboard pane.",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "check": "ultracite check && pnpm typecheck && pnpm build",
    "clean": "node --run clean:dist",
    "clean:dist": "rm -rf dist",
    "fix": "ultracite fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neon/sdk": "1.4.0",
    "effect": "3.22.1",
    "ink": "6.8.0",
    "open": "10.2.0",
    "openid-client": "6.8.1",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.2.18",
    "eslint-plugin-github": "6.1.2",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "tsup": "8.5.1",
    "tsx": "4.23.4",
    "typescript": "7.0.2",
    "ultracite": "7.10.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.5.3"
}
